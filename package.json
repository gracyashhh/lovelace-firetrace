{
  "name": "firetrace",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc && node scripts/build.mjs",
    "start": "node build/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:prepare": "python3 scripts/ingest.py",
    "budget": "node --import tsx scripts/budget-status.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
